# ─── Base de datos ───────────────────────────────────
DATABASE_URL="mysql://app:apppass@localhost:3306/goto"

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET="cambiar-por-un-secreto-seguro-en-produccion"
JWT_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ─── IA (Opciones: Ollama o Gemini) ────────────────────
# Usar Ollama solo si tienes un servidor Ollama levantado
USE_OLLAMA="false"
# Si Ollama corre en una Raspberry Pi o en otro host, pon su IP o DNS aquí
OLLAMA_API_URL="http://192.168.1.50:11434"
OLLAMA_MODEL="qwen2.5:3b-instruct"

# O Gemini (requiere API Key, pero más potente)
# Si no se configura OLLAMA, el backend fallback a Gemini si está disponible.
# Si tampoco hay Google API Key, usa recomendaciones heurísticas locales.
GOOGLE_API_KEY="pon_aqui_tu_google_api_key"
GEMINI_MODEL="gemini-2.0-flash"

